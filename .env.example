# Configuraci??n del microservicio (Twelve-Factor II: config via entorno).
#
# OPCIONAL. El compose usa `env_file` con `required: false`: sin este
# archivo el servicio arranca igual y toma los defaults de
# `core/config.py`. Copiarlo solo para sobreescribirlos:
#
#   cp .env.example .env
#
# OJO: con `env_file` presente, este archivo hace doble trabajo: adem??s
# de configurar el contenedor, sus variables se usan para interpolar el
# propio compose (EXTRACTOR_HOST, MEM_LIMIT, PORT en las labels). Por eso
# las de compose tambi??n terminan como variables de entorno del proceso.

# --- Port binding (Twelve-Factor III) ---
PORT=8000
HOST=0.0.0.0

# --- Tama??o y timeouts ---
MAX_UPLOAD_SIZE_MB=12
EXTRACT_TIMEOUT_SECONDS=25.0
ADMISSION_TIMEOUT_SECONDS=10.0

# --- Concurrencia (ADR-TP-5) ---
UVICORN_WORKERS=2
EXTRACTION_POOL_SIZE=2
MAX_CONCURRENT_EXTRACTIONS=4
QUEUE_MAX_SIZE=64

# --- L??mites del runtime HTTP (ADR-TP-7) ---
# OJO: HTTP_LIMIT_CONCURRENCY es POR WORKER. Con UVICORN_WORKERS=2 y
# valor 6 el tope real de conexiones simult??neas es 12. Dimensionar
# contra MAX_CONCURRENT_EXTRACTIONS + margen para /health.
# Para desactivarlo hay que sacar la variable: compose usa ${VAR:-6},
# que tambi??n reemplaza un valor vac??o, as?? que "vac??o" no lo apaga.
HTTP_LIMIT_CONCURRENCY=6
HTTP_TIMEOUT_KEEP_ALIVE=5.0
# Access log de Uvicorn por request. Es la ??nica l??nea por request que
# hay hoy: poner en false solo cuando exista el middleware de ISSUE-014.
HTTP_ACCESS_LOG=true

# --- Frontend (Traefik) ---
# Host que matchea la regla del router. Debe resolver al proxy.
EXTRACTOR_HOST=universidad.localhost
# Tope de memoria del contenedor. Referencia: 256m, insuficiente para
# PDFs de ~9 MB bajo carga; 512m es el punto de partida, medir con el TP.
MEM_LIMIT=512m

# --- Formatos aceptados ---
ALLOWED_MIME_TYPES=application/pdf

# --- Entorno y logs (Twelve-Factor XI: stdout) ---
ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Service Discovery (Consul) ---
# Registro automatico al iniciar y desregistro al apagar. El servicio
# sigue funcionando aunque Consul no este disponible (best-effort).
SERVICE_DISCOVERY_ENABLED=true
CONSUL_HOST=consul
CONSUL_PORT=8500
SERVICE_NAME=extractor
SERVICE_ID=
SERVICE_HOST=
SERVICE_ADDRESS_MODE=ip
SERVICE_PORT=8000
SERVICE_HEALTH_PATH=/health
HEALTH_CHECK_INTERVAL=10s
HEALTH_CHECK_TIMEOUT=5s
DEREGISTER_CRITICAL_AFTER=60s
CONSUL_REGISTER_RETRIES=1
CONSUL_REGISTER_BACKOFF=0.5
CONSUL_TIMEOUT=2.0
