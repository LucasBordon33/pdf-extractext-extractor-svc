# Configuración del microservicio (Twelve-Factor II: config via entorno).
# Copiar a .env o definir en el entorno del contenedor; sin .env,
# los defaults de acá aplican (docker compose up --build funciona solo).

# --- Port binding (Twelve-Factor III) ---
PORT=8000
HOST=0.0.0.0

# --- Tamaño y timeouts ---
MAX_UPLOAD_SIZE_MB=12
EXTRACT_TIMEOUT_SECONDS=25.0
ADMISSION_TIMEOUT_SECONDS=10.0

# --- Concurrencia (ADR-TP-5) ---
UVICORN_WORKERS=2
EXTRACTION_POOL_SIZE=2
MAX_CONCURRENT_EXTRACTIONS=4
QUEUE_MAX_SIZE=64

# --- Formatos aceptados ---
ALLOWED_MIME_TYPES=application/pdf

# --- Entorno y logs (Twelve-Factor XI: stdout) ---
ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json
