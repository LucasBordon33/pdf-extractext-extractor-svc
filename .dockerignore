# Control de versiones
.git
.gitignore

# Entornos y secretos (Settings lee .env: nunca entra a la imagen)
.venv
.env
.env.example

# Artefactos de Python
__pycache__/
**/__pycache__/
*.pyc
*.egg-info/
build/
dist/

# Cachés de tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
cache/

# Dataset de stress testing: no entra a la imagen de producción.
# Los PDFs pesan ~9 MB y los resultados son artefactos locales.
tests/stress/pdfs
tests/stress/results
tests/stress/pdfs/manifest.json

# Logs
*.log

# Meta del propio Docker (no cambia el contexto de build)
Dockerfile
.dockerignore

# Documentación no requerida en la imagen
*.md
LICENSE
